<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MISSION: SECURED | Tactical Handshake</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        :root {
            --neo-cyan: #00FFFF;
            --neo-red: #ff0033;
        }
        body {
            background-color: #02040a;
        }
        .success-hero {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at center, #0a0b1e 0%, #02040a 100%);
        }
        .hud-grid {
            background-image: linear-gradient(rgba(0, 255, 255, 0.05) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(0, 255, 255, 0.05) 1px, transparent 1px);
            opacity: 0.3;
        }
        .mission-card {
            border: 2px solid var(--neo-cyan);
            padding: 3rem;
            max-width: 650px;
            text-align: center;
            background: rgba(10, 11, 30, 0.95);
            position: relative;
            box-shadow: 0 0 100px rgba(0, 255, 255, 0.1);
            animation: blueCardIn 0.8s cubic-bezier(0.19, 1, 0.22, 1);
        }
        @keyframes blueCardIn {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .alert-bar {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--neo-cyan);
            box-shadow: 0 0 20px var(--neo-cyan);
        }
        .sync-progress-container {
            width: 100%;
            height: 4px;
            background: rgba(0, 255, 255, 0.1);
            margin: 1.5rem 0;
            position: relative;
        }
        .sync-progress-bar {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            background: var(--neo-cyan);
            box-shadow: 0 0 15px var(--neo-cyan);
            animation: syncProgress 3s forwards ease-in-out;
        }
        @keyframes syncProgress {
            from { width: 75%; }
            to { width: 100%; }
        }
        .neo-stamp {
            font-family: 'Orbitron';
            font-size: 3.5rem;
            color: var(--neo-red);
            font-weight: 900;
            border: 8px solid var(--neo-red);
            display: inline-block;
            padding: 10px 30px;
            transform: rotate(-12deg);
            margin-bottom: 2rem;
            filter: drop-shadow(0 0 30px var(--neo-red));
            text-shadow: 0 0 15px var(--neo-red);
            background: rgba(255, 0, 51, 0.05);
            position: relative;
            animation: stampSlam 0.3s forwards cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @keyframes stampSlam {
            0% { transform: scale(5) rotate(0); opacity: 0; }
            100% { transform: scale(1) rotate(-12deg); opacity: 1; }
        }
        .mission-title {
            font-family: 'Orbitron';
            font-size: 2.2rem;
            color: #fff;
            letter-spacing: 5px;
            margin-bottom: 1rem;
            text-transform: uppercase;
            text-shadow: 0 0 20px var(--neo-cyan);
        }
        .return-btn {
            display: inline-block;
            margin-top: 2rem;
            padding: 1.2rem 3.5rem;
            background: linear-gradient(90deg, var(--neo-cyan), var(--neo-violet));
            color: #fff;
            text-decoration: none;
            font-family: 'Orbitron';
            font-weight: 900;
            letter-spacing: 5px;
            transition: all 0.3s;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
            font-size: 0.9rem;
        }
        .return-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 50px var(--neo-cyan);
            filter: brightness(1.2);
        }
    </style>
</head>
<body>
    <div class="cursor-crosshair" id="cursorCrosshair"></div>
    <div class="cursor-dot" id="cursorDot"></div>
    
    <div class="background-canvas">
        <div class="hud-grid"></div>
        <div class="jarvis-hub" style="bottom: 50%; opacity: 0.15;">
            <div class="hub-ring" style="width: 100%; height: 100%;"></div>
            <div class="hub-ring" style="width: 70%; height: 70%; animation-direction: reverse;"></div>
        </div>
    </div>

    <main class="success-hero">
        <div class="mission-card">
            <div class="alert-bar"></div>
            <div class="neo-stamp">ACCEPTED</div>
            <h1 class="mission-title">Mission Secured</h1>
            
            <div class="sync-progress-container">
                <div class="sync-progress-bar"></div>
                <div style="position: absolute; right: 0; top: -20px; font-size: 0.6rem; color: var(--neo-cyan);">SYNC_COMPLETE</div>
            </div>

            <p style="font-size: 0.9rem; opacity: 0.9; max-width: 500px; margin: 0 auto; line-height: 1.6;">
                Agent <strong><%= fullname %></strong>, the transmission is secured within the **NEO SECTOR**. 
            </p>
            
            <div style="margin: 1rem auto; padding: 1rem; border: 1px dashed var(--neo-cyan); background: rgba(0,255,255,0.05); max-width: 450px; text-align: left;">
                <div style="font-size: 0.6rem; color: var(--neo-cyan); margin-bottom: 0.3rem; letter-spacing: 2px;">DECRYPTED_MISSION_LOG:</div>
                <div style="font-family: 'JetBrains Mono'; font-size: 0.8rem; color: #fff; line-height: 1.3;">
                    <%= message || "" %>
                </div>
            </div>

            <p style="font-size: 0.8rem; opacity: 0.7;">Deployment status is now 100%.</p>
            
            <div style="margin-top: 1.5rem; display: flex; justify-content: center; gap: 3rem; border-top: 1px solid rgba(0,255,255,0.2); padding-top: 1.5rem;">
                <div>
                    <div style="font-size: 0.6rem; color: var(--neo-cyan);">STATUS</div>
                    <div style="font-weight: bold; color: #fff; font-size: 0.8rem;">ACTIVE</div>
                </div>
                <div>
                    <div style="font-size: 0.6rem; color: var(--neo-cyan);">SECTOR</div>
                    <div style="font-weight: bold; color: #fff; font-size: 0.8rem;">ALPHA-7</div>
                </div>
                <div>
                    <div style="font-size: 0.6rem; color: var(--neo-cyan);">ENCRYPTION</div>
                    <div style="font-weight: bold; color: #fff; font-size: 0.8rem;">SECURE_X</div>
                </div>
            </div>

            <a href="/" class="return-btn">NEW MISSION</a>
        </div>
    </main>

    <script src="/script.js"></script>
</body>
</html>
