<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JARVIS V7 | Tactical Intelligence</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="cursor-crosshair" id="cursorCrosshair"></div>
    <div class="cursor-dot" id="cursorDot"></div>

    <div class="background-canvas">
        <div class="hud-grid"></div>
    </div>

    <div class="container">
        <section class="hero">
            <div style="font-size: 1rem; color: var(--neo-cyan); margin-bottom: 1.5rem; letter-spacing: 8px; font-weight: bold;">[ SYSTEM: JARVIS_V7 ]</div>
            <h1 id="mainTitle">VAL: X</h1>
            <p style="font-size: 1.1rem; opacity: 0.8;">Intelligence gathering platform. Advanced tactical validation architecture for high-stakes digital operations. Restricted to authorized personnel only.</p>
            
            <div class="dna-container">
                <div class="dna-strand" style="animation-delay: 0.1s;"></div>
                <div class="dna-strand" style="animation-delay: 0.2s;"></div>
                <div class="dna-strand" style="animation-delay: 0.3s;"></div>
                <div class="dna-strand" style="animation-delay: 0.4s;"></div>
                <div class="dna-strand" style="animation-delay: 0.5s;"></div>
                <div class="dna-strand" style="animation-delay: 0.6s;"></div>
            </div>

            <div class="hero-middle-details">
                <div class="detail-box" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                    <div class="dual-circles">
                        <div class="circle-outer"></div>
                        <div class="circle-inner"></div>
                    </div>
                    <div class="detail-label" style="margin-top: 10px;">CORE_SYNC</div>
                </div>
                <div class="detail-box">
                    <div class="detail-label">UPLINK_STABILITY</div>
                    <div style="height: 30px; background: rgba(0, 255, 255, 0.1); position: relative; margin-top: 10px;">
                        <div style="position: absolute; left: 0; top: 0; height: 100%; width: 88%; background: var(--neo-cyan); box-shadow: 0 0 20px var(--neo-cyan);"></div>
                    </div>
                    <div style="text-align: right; margin-top: 10px; font-weight: bold;">880 MB/S</div>
                </div>
                <div class="detail-box">
                    <div class="detail-label">ENCRYPTION_LAYER</div>
                    <div style="color: var(--neo-pink); font-weight: bold; font-size: 1rem;">AES-256_ACTIVE</div>
                    <div style="opacity: 0.7; margin-top: 10px;">KEY_0x9B1C...</div>
                </div>
            </div>

            <div class="bottom-widgets">
                <div class="globe-container">
                    <div class="globe">
                        <div class="globe-ring"></div>
                        <div class="globe-ring"></div>
                        <div class="globe-ring"></div>
                        <div class="globe-ring"></div>
                        <div class="globe-ring"></div>
                        <div class="globe-ring"></div>
                        <div class="globe-inner"></div>
                    </div>
                    <div style="position: absolute; font-size: 0.8rem; color: var(--neo-cyan); bottom: -10px; letter-spacing: 3px; font-weight: bold;">GLOBAL_CORE</div>
                </div>
                <div style="flex: 1; border: 1px solid var(--hud-border); padding: 1.5rem; height: 120px; background: rgba(0,255,255,0.05);">
                    <div class="detail-label">NEURAL_SYNC_FEED</div>
                    <div id="neuralFeed" style="display: flex; gap: 4px; height: 50px; margin-top: 10px;">
                        <div style="flex: 1; background: var(--neo-cyan); opacity: 0.4;"></div>
                        <div style="flex: 1; background: var(--neo-cyan); opacity: 1;"></div>
                        <div style="flex: 1; background: var(--neo-cyan); opacity: 0.6;"></div>
                        <div style="flex: 1; background: var(--neo-cyan); opacity: 0.8;"></div>
                    </div>
                </div>
                <div style="width: 300px; border: 1px solid var(--hud-border); padding: 1.5rem; height: 120px; background: rgba(0,255,255,0.05);">
                    <div class="detail-label">PACKET_FEED</div>
                    <div id="packetLog" style="color: #fff; opacity: 0.9; height: 50px; overflow: hidden; margin-top: 10px; font-size: 0.8rem;"></div>
                </div>
            </div>
        </section>

        <aside class="interaction-zone">
            <div class="command-panel" id="mainPanel">
                <div style="margin-bottom: 3rem; border-left: 6px solid var(--neo-cyan); padding-left: 1.5rem;">
                    <h2 style="font-family: 'Orbitron'; font-size: 2rem; letter-spacing: 4px; text-transform: uppercase;">Command Entry</h2>
                </div>
                
                <form action="/validate" method="POST" id="validationForm">
                    <div class="form-group">
                        <label>OPERATIVE IDENTIFIER</label>
                        <input type="text" id="fullname" name="fullname" placeholder="CODENAME / IDENTITY" required>
                    </div>
                    <div class="form-group">
                        <label>SECURE UPLINK</label>
                        <input type="email" id="email" name="email" placeholder="AGENT@JARVIS.AI" required>
                    </div>
                    <div class="form-group">
                        <label>ACCESS CIPHER</label>
                        <input type="password" id="password" name="password" placeholder="SECRET_PROTOCOL" required>
                    </div>
                    <div class="form-group">
                        <label>COMMS CHANNEL</label>
                        <input type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000" required>
                    </div>
                    <div class="form-group">
                        <label>MISSION NOTES</label>
                        <textarea id="message" name="message" rows="3" placeholder="MISSION_OBJECTIVES..."></textarea>
                    </div>

                    <button type="submit" class="btn-transmit" id="submitBtn">
                        Initiate Deployment
                    </button>
                </form>

                <div style="margin-top: 3rem; font-size: 0.9rem; color: var(--neo-pink); font-weight: bold;" id="systemLog">
                    > INITIALIZING JARVIS_V7...
                </div>
            </div>
        </aside>
    </div>

    <script src="/script.js"></script>
</body>
</html>
